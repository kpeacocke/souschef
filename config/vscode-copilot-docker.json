{
  "servers": {
    "souschef": {
      "type": "stdio",
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "--env",
        "SOUSCHEF_WORKSPACE_ROOT=/workspace",
        "--mount",
        "type=bind,source=/absolute/path/to/migration-workspace,target=/workspace",
        "souschef-mcp:latest"
      ]
    }
  }
}
